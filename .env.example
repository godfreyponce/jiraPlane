# Copy to .env and fill in real values. .env is gitignored — never commit it.
# PLACEHOLDERS ONLY in this file (the repo is public).

# --- Jira (Data Center) ---
JIRA_BASE_URL=https://YOUR-JIRA-HOST
JIRA_USERNAME=your-jira-username
JIRA_USER_KEY=JIRAUSER00000
JIRA_PAT=your-personal-access-token

# --- Pick your outputs ---
# Both lines below are optional. Defaults: plane on, Teams DMs off.
# TEAMS_WEBHOOK_URL=https://your-power-automate-webhook-url
# PLANE=0

# Optional tuning (defaults live in poller.js):
# POLL_SECONDS, LOOKBACK_MINUTES, COMMENTS_PER_ISSUE, PRUNE_DAYS,
# MAX_EVENTS_PER_CYCLE, SNIPPET_CHARS
